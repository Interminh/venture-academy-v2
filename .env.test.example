# Test against a local `npm run dev` by default. Set this to point at a deployed site instead.
# E2E_BASE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin account the Playwright suite logs in as to drive admin-only flows.
VAT_QA_ADMIN_EMAIL=
VAT_QA_ADMIN_PASSWORD=
