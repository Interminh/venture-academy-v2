# Copy to .env.local and fill in from your Supabase project's Settings > API page.
# See SETUP.md for the full walkthrough.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this to the browser or prefix it with
# NEXT_PUBLIC_. Used by the notification unsubscribe link, which has to
# work with no logged-in session, and by anything else that needs to
# bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Powers the "session booked" notification emails to
# parents and tutors (lib/email/notifications.ts). Get a key from
# resend.com. Leave blank to skip sending, nothing else in the app
# depends on this.
RESEND_API_KEY=

# Optional. Defaults to Resend's shared test address if unset, replace
# once you've verified a real domain with Resend.
RESEND_FROM_EMAIL=
