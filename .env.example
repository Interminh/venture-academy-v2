# Copy to .env.local and fill in from your Supabase project's Settings > API page.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Resend key for session emails. Leave blank to skip sending.
RESEND_API_KEY=

# Optional. Defaults to Resend's test address until you verify a domain.
RESEND_FROM_EMAIL=
