# Copy to .env.local and fill in from your Supabase project's Settings > API page.
# See SETUP.md for the full walkthrough.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this to the browser or prefix it with
# NEXT_PUBLIC_. Not currently used by the app, but useful to have on hand
# for admin scripts and anything that needs to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=
