# Copy to .env.local and fill in from your Supabase project's Settings > API page.
# See SETUP.md for the full walkthrough.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never exposed to the browser, never prefixed with NEXT_PUBLIC_.
# Used only by the admin invite Server Action (lib/actions/users.ts).
SUPABASE_SERVICE_ROLE_KEY=
